diff --git a/modloader/mods/init.lua b/modsand/mods/init.lua
index d78ec59..6fc2487 100644
--- a/mods/init.lua
+++ b/mods/init.lua
@@ -93,6 +93,49 @@ function M.applyOverrides()
 
     scan(root)
     -- @ANDROID_OVERRIDES_START
+    local extRoot = "/sdcard/apotheosis/overrides"
+    os.execute('mkdir -p "' .. extRoot .. '" 2>/dev/null')
+    local p = io.popen('find "' .. extRoot ..
+                           '" -type f -name "*.lua" 2>/dev/null')
+    if p then
+        for fullPath in p:lines() do
+            local modName = fullPath:sub(#extRoot + 2):gsub("%.lua$", ""):gsub(
+                                "/", ".")
+            if package.loaded[modName] then
+                print("[SubstratumA] WARNING: Override for '" .. modName ..
+                          "' ignored (already loaded)")
+            else
+                M.overrides[modName] = "preloaded"
+                package.loaded[modName] = nil
+                package.preload[modName] = function()
+                    local chunk, err = loadfile(fullPath)
+                    if not chunk then
+                        M.overrides[modName] = "syntax error"
+                        print("[SubstratumA] Syntax error in override " ..
+                                  fullPath .. ": " .. tostring(err))
+                        error(err)
+                    end
+                    local ok, res = pcall(chunk)
+                    if not ok then
+                        M.overrides[modName] = "runtime error"
+                        print("[SubstratumA] Runtime error in override " ..
+                                  fullPath .. ": " .. tostring(res))
+                        error(res)
+                    end
+                    if res == nil then
+                        M.overrides[modName] = "nil return"
+                        print("[SubstratumA] Override " .. fullPath ..
+                                  " returned nil (forgot `return`?)")
+                        error("returned nil")
+                    end
+                    M.overrides[modName] = "applied"
+                    return res
+                end
+                print("[SubstratumA] Preloaded override: " .. modName)
+            end
+        end
+        p:close()
+    end
     -- @ANDROID_OVERRIDES_END
 end
 
@@ -205,7 +248,66 @@ function M.loadMods(game)
         end
     end
     -- @ANDROID_MODS_START
-    -- @ANDROID_MODS_END
+    local extMods = "/sdcard/apotheosis/mods"
+    os.execute('mkdir -p "' .. extMods .. '" 2>/dev/null')
+    local mp = io.popen('ls -1 "' .. extMods .. '" 2>/dev/null')
+    if mp then
+        for folder in mp:lines() do
+            local modEntry = extMods .. "/" .. folder .. "/mod.lua"
+            local f = io.open(modEntry, "r")
+            if f then
+                f:close()
+                local isDisabled = (M.disabled[folder] == true)
+                local record = {
+                    name = folder,
+                    _folder = folder,
+                    _path = extMods .. "/" .. folder,
+                    _external = true,
+                    _enabled = not isDisabled,
+                    _core = false
+                }
+                table.insert(M.discovered, record)
+                if isDisabled then
+                    print("[SubstratumA] Skipped (disabled): " .. folder)
+                else
+                    local chunk, loadErr = loadfile(modEntry)
+                    if chunk then
+                        local ok, mod = pcall(chunk)
+                        if ok and type(mod) == "table" then
+                            mod._folder, mod._path, mod._external, mod._enabled, mod._core =
+                                folder, extMods .. "/" .. folder, true, true,
+                                false
+                            M.discovered[#M.discovered] = mod
+                            table.insert(M.loaded, mod)
+                            print("[SubstratumA] Loaded: " ..
+                                      (mod.name or folder))
+                            if mod.init then
+                                local initOk, err =
+                                    pcall(mod.init, mod, game, folder)
+                                if not initOk then
+                                    mod._error = tostring(err)
+                                    print(
+                                        "[SubstratumA] Error in " .. folder ..
+                                            ": " .. tostring(err))
+                                end
+                            end
+                        else
+                            record._error = tostring(mod)
+                            print("[SubstratumA] Failed: " .. folder .. " (" ..
+                                      tostring(mod) .. ")")
+                        end
+                    else
+                        record._error = tostring(loadErr)
+                        print(
+                            "[SubstratumA] Syntax error in " .. folder .. ": " ..
+                                tostring(loadErr))
+                    end
+                end
+            end
+        end
+        mp:close()
+    end
+  -- @ANDROID_MODS_END
 end
 
 return M
